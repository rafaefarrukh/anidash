# Maintainer: Muhammad Rafae Farrukh <rafaefarrukh at gmail dot com>
pkgname=anidash
pkgver=2.0.0
pkgrel=1
pkgdesc="Follow your AniList Watching list: new episodes are found on Nyaa, downloaded with qBittorrent, named and synced back"
arch=('any')
url="https://github.com/rafaefarrukh/anidash"
license=('MIT')
# Repo packages ([extra]); the three marked AUR are not in the official repos as far as we know —
# check with `pacman -Si` / `paru -Si` before publishing and adjust.
depends=(
  'python>=3.11'
  'python-fastapi' 'uvicorn' 'python-apscheduler' 'python-httpx' 'python-keyring' 'python-platformdirs'
  'python-send2trash' 'python-psutil' 'python-pillow'
  'libtorrent-rasterbar'    # the built-in download engine (includes the Python bindings)
  'python-gobject' 'webkit2gtk-4.1' 'libayatana-appindicator'
  'python-pywebview'        # AUR
  'python-pystray'          # AUR
  'python-qbittorrent-api'  # AUR
)
makedepends=('python-build' 'python-installer' 'python-hatchling')
checkdepends=('python-pytest')
optdepends=(
  'qbittorrent: optional download backend instead of the built-in engine (desktop)'
  'qbittorrent-nox: optional download backend instead of the built-in engine (headless)'
  'vlc: preferred player (otherwise the default video player is used)'
  'gnome-shell-extension-appindicator: tray icon on GNOME'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replace with the real sum: updpkgsums

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  PYTHONPATH=src python -m pytest -q tests -p no:cacheprovider -k "not integration"
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 packaging/linux/anidash.desktop "$pkgdir/usr/share/applications/anidash.desktop"
  install -Dm644 src/anidash/assets/icon.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/anidash.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
