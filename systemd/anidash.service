[Unit]
Description=anidash — anime episode automation service
Documentation=file://%h/.local/share/anime-dl/app/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/anime-dl/app
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/.local/share/anime-dl/app
ExecStart=%h/.local/share/anime-dl/venv/bin/python -m anidash serve
Restart=on-failure
RestartSec=10
# hardening (user-level; files stay writable under $HOME)
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
